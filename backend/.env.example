APP_NAME=AI Study Platform API
APP_ENV=development
DEBUG=true
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://172.16.0.2:3000"]

# Neon PostgreSQL. Use a backend-only connection string.
# Example scheme depends on your SQLAlchemy/psycopg setup; never commit real credentials.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DBNAME?sslmode=require
# Optional direct Neon connection for Alembic migrations; use a direct hostname without -pooler.
DATABASE_URL_UNPOOLED=postgresql+psycopg://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Supabase Auth verification (use values required by the chosen verification method).
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_JWT_ISSUER=https://YOUR_PROJECT_REF.supabase.co/auth/v1
SUPABASE_JWT_JWKS_URL=https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_AUDIENCE=authenticated

# Cloudinary: server-side only
CLOUDINARY_CLOUD_NAME=YOUR_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_API_KEY
CLOUDINARY_API_SECRET=YOUR_API_SECRET
CLOUDINARY_FOLDER=study-platform

# Gemini: server-side only
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=choose-supported-embedding-model-after-checking-current-docs

# Operational controls
MAX_UPLOAD_MB=30
SIGNED_UPLOAD_TTL_SECONDS=600
RATE_LIMIT_PER_MINUTE=30
LOG_LEVEL=INFO

