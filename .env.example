APP_NAME=AI Study Platform API
APP_ENV=development
DEBUG=true
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://172.16.0.2:3000"]

# Neon PostgreSQL Database
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL_UNPOOLED=postgresql+psycopg://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Neon Object Storage (S3-compatible API)
AWS_ACCESS_KEY_ID=YOUR_NEON_STORAGE_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_NEON_STORAGE_SECRET_ACCESS_KEY
AWS_ENDPOINT_URL_S3=https://YOUR_NEON_PROJECT_ID.us-east-2.aws.neon.tech
AWS_REGION=us-east-2
NEON_STORAGE_BUCKET=ai-documents

# Supabase Auth verification
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_JWT_ISSUER=https://YOUR_PROJECT_REF.supabase.co/auth/v1
SUPABASE_JWT_JWKS_URL=https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_AUDIENCE=authenticated

# Gemini AI / LLM Configuration
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Cloudinary (Legacy / Migration source only)
CLOUDINARY_CLOUD_NAME=YOUR_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_API_KEY
CLOUDINARY_API_SECRET=YOUR_API_SECRET
CLOUDINARY_FOLDER=study-platform

# Operational controls
MAX_UPLOAD_MB=30
SIGNED_UPLOAD_TTL_SECONDS=600
RATE_LIMIT_PER_MINUTE=30
LOG_LEVEL=INFO
